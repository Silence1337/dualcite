<biblStruct xml:id="b50">
	<monogr>
		<title level="m" type="main">Causal Relationship: One event (or action) serves as the cause of another event (or action)</title>
		<imprint/>
	</monogr>
	<note>where the latter is the result of the former</note>
</biblStruct>

<biblStruct xml:id="b51">
	<monogr>
