		<imprint/>
	</monogr>
</biblStruct>

<biblStruct xml:id="b52">
	<monogr>
		<title level="m" type="main">Oppositional Relationship: Two events (or actions) oppose each other in terms of goals, intentions</title>
		<imprint/>
	</monogr>
	<note>or outcomes</note>
</biblStruct>

<biblStruct xml:id="b53">
	<monogr>
		<title level="m" type="main">Inclusion Relationship: One event (or action) is a subset or a specific manifestation of another event</title>
		<imprint/>
	</monogr>
	<note>or action</note>
</biblStruct>

