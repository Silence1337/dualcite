<biblStruct xml:id="b16">
	<monogr>
		<title level="m" type="main">Use the **same ID** consistently for all mentions of the same entity</title>
		<imprint/>
	</monogr>
	<note>even across paragraphs</note>
</biblStruct>

<biblStruct xml:id="b17">
	<monogr>
		<title level="m" type="main">Do **not annotate singleton mentions**</title>
		<imprint/>
	</monogr>
	<note>those that appear only once in the text</note>
</biblStruct>

<biblStruct xml:id="b18">
	<monogr>
		<title level="m" type="main">Annotate **all types of coreference**: full noun phrases, pronouns, nested noun mentions, and even abstract or generic references like &quot;such outcomes</title>
