</biblStruct>

<biblStruct xml:id="b33">
	<monogr>
		<title level="m" type="main">Stay curious-never assume. Help clients explore their local knowledge and resources</title>
		<imprint/>
	</monogr>
</biblStruct>

<biblStruct xml:id="b34">
	<monogr>
		<title level="m" type="main">Keep it informal, connected to real-life context, and avoid sounding like AI or academic writing</title>
		<imprint/>
	</monogr>
</biblStruct>

<biblStruct xml:id="b35">
	<monogr>
		<title level="m" type="main">Match the client&apos;s natural language style-clear, relatable, and never abstract or jargon-filled</title>
		<imprint/>
	</monogr>
</biblStruct>

<biblStruct xml:id="b36">
	<monogr>
		<title level="m" type="main">Ask only one question at a time, progressing gently and naturally. 5. Speak like a caring friend</title>
