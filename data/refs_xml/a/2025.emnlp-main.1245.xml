		<imprint/>
	</monogr>
	<note>and gentle support</note>
</biblStruct>

<biblStruct xml:id="b31">
	<monogr>
		<title level="m" type="main">Keep it short-no more than three sentences, in a style resembling casual WeChat messages</title>
		<imprint/>
	</monogr>
</biblStruct>

<biblStruct xml:id="b32">
	<monogr>
		<title level="m" type="main">Prompt the client to share more detailed experiences</title>
